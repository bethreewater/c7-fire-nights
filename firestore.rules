rules_version = '2';

// 夏夜火舞 · 訂位系統 Firestore 安全規則
// 原則：客人能訂位、能看到「剩幾位」，但看不到別人的姓名電話；
//       只有後台（管理員帳號）登入後讀得到完整訂位。
service cloud.firestore {
  match /databases/{database}/documents {

    // 後台 = 指定的管理員 e-mail（只有這個帳號算 admin）。
    // 即使有人自行註冊 Auth 帳號，email 不符也讀不到任何個資。
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'mryomryo@gmail.com';
    }

    // JS SDK 寫入的數字可能是 int 或 float（double），兩者都接受。
    function isNum(v) { return v is int || v is float; }

    // 場次：公開可讀（只有名額數字、無個資）；僅後台可寫
    match /sessions/{sid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 夥伴折扣碼：公開可讀（book.html 驗碼用，只含代碼/名稱/類別，無個資）；僅後台可寫
    match /partners/{pid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 保留（hold）：放在 sessions/{sid}/holds/{id}，但前台用 collectionGroup 查詢，
    // 需用遞迴萬用比對才涵蓋 collection group。欄位只允許座位數/到期/連結 id，無個資。
    match /{path=**}/holds/{holdId} {
      allow read: if true;
      // ⛔ 2026-08-07 活動結束，不再接受新訂位（見下方 bookings 說明）
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // 訂位：含個資。只有後台可讀／改／刪。
    // ⛔ 2026-08-07 活動結束（用戶決定不再續辦）：新訂位一律拒絕。
    //    這是「關掉名額」的最後一道閘——即使有人開著舊分頁、存了直連或跳過前端，
    //    也送不出訂位。既有訂位不受影響，後台仍可讀取／改期／取消。
    //    ▸ 日後若重辦：把 `allow create: if false;` 換回原本的欄位檢查規則
    //      （原文在 git 歷史 commit 0a36d30 的這個檔案），並把 booking-store.js
    //      的 SEASON_ENDED 改回 false，兩處要一起改。
    match /bookings/{bid} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // 內測回饋：任何人可送出一筆（欄位數與長文受限，防濫用）；只有後台可讀／改／刪
    match /feedback/{fid} {
      allow read, update, delete: if isAdmin();
      allow create: if isNum(request.resource.data.createdAt)
                     && request.resource.data.size() <= 40
                     && (!('q13_improve' in request.resource.data) || request.resource.data.q13_improve.size() <= 2000)
                     && (!('q2_why' in request.resource.data) || request.resource.data.q2_why.size() <= 2000)
                     && (!('name' in request.resource.data) || request.resource.data.name.size() <= 40);
    }
  }
}
